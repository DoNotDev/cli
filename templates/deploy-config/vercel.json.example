{{#isNextjs}}{
  "framework": "nextjs",
  "installCommand": "bun install"
}{{/isNextjs}}{{^isNextjs}}{
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "installCommand": "bun install",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/_shell"
    }
  ]
}{{/isNextjs}}