import type { Metadata } from 'next';
import { headers } from 'next/headers';

import { getMetadataForPath } from '@donotdev/core/next';
import { FontPreloadLinks } from '@donotdev/ui/next';

import '../globals.css';
import { ClientLayout } from './ClientLayout';

/**
 * Framework fonts are loaded via CSS @font-face rules in dndev.css (bundled).
 * Font preload links are injected at build time; FontPreloadLinks reads the manifest for SSR.
 */

/**
 * Dynamic metadata generation from PageMeta exports.
 * Same PageMeta convention works in Vite (AutoMetaTags) and Next.js (this function).
 * Priority: i18n meta.fullTitle > seo.fullTitle > i18n title | siteName > siteName
 *
 * For dynamic pages with runtime data, use <Seo> component instead.
 */
export async function generateMetadata(): Promise<Metadata> {
  // Root layout handles the home page metadata
  // Other pages override via their own generateMetadata or <Seo> component
  return getMetadataForPath('/');
}

// SSR (appConfig.ssr): render dynamically at request time. The provider tree is
// store-driven (theme/layout/i18n/overlay read live during render), so it is
// inherently dynamic under React 19. Setting it on the root layout covers every
// route in one place — generated pages, hand-written pages, and /_not-found.
// Content is still fully server-rendered and crawlable. Remove only if this app
// opts back out of SSR and returns to static export.
export const dynamic = 'force-dynamic';

/**
 * Root layout for Next.js App Router
 *
 * Theme detection happens client-side via ClientLayout to avoid
 * Next.js 16 + Turbopack race condition with async layouts.
 * Brief FOUC possible on first load, but prevents build-manifest.json errors.
 */
/**
 * Passes the request's Cookie and Accept-Language headers to the providers: the server
 * render and the hydration pass then show the visitor's language and signed-in state
 * on the first paint. Async child, so the root layout itself stays synchronous.
 */
async function RequestLayout({ children }: { children: React.ReactNode }) {
  const requestHeaders = await headers();
  return (
    <ClientLayout
      serverCookies={requestHeaders.get('cookie') ?? ''}
      acceptLanguage={requestHeaders.get('accept-language')}
    >
      {children}
    </ClientLayout>
  );
}

export default function RootLayout({
  children,
}: {
  children: React.ReactNode;
}) {
  return (
    <html
      lang="en"
      className="dndev-design-tokens light"
      suppressHydrationWarning
    >
      <head>
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <FontPreloadLinks />
      </head>
      <body className="light">
        <RequestLayout>{children}</RequestLayout>
      </body>
    </html>
  );
} 