/**
 * src/themes.css — SSOT for essence and theme variables. Import in globals.css only.
 * Default = SaaS (Inter). Optional .brutalist and .luxury do not apply until class is set on <html>.
 */
/* src/themes.css */

/* ===========================
   APP-WIDE SETTINGS
   =========================== */
:root {
  /* Routing animations (fade | slide | none) */
  /* --routing-animation: fade; */
  /* --routing-default-duration: var(--dur-normal); */

  /* Spacing scale */
  /* --gap-sm: 0.5rem; */
  /* --gap-md: 1rem; */
  /* --gap-lg: 2rem; */

  /* Border radius */
  /* --radius-interactive: var(--radius-none); */
  /* --radius-surface: var(--radius-md); */
  /* --radius-floating: var(--radius-none); */

  /* Form placeholders (Select, Input, Combobox, etc.) */
  /* --placeholder: rgb(from var(--muted-foreground) r g b / 0.6); */
}

/* ===========================
   LIGHT THEME
   Zinc-based neutral palette
   =========================== */
:root.light {
  --theme-icon: 'Sun';
  --theme-label: 'Light';
  --theme-is-dark: 0;

  /* Core colors */
  --background: #ffffff;
  --foreground: #09090b;

  /* Surfaces */
  --card: #ffffff;
  --card-foreground: #09090b;
  --popover: #ffffff;
  --popover-foreground: #09090b;

  /* Muted (zinc-100 / zinc-500) */
  --muted: #f4f4f5;
  --muted-foreground: #71717a;

  /* Border & input (zinc-200) */
  --border: #e4e4e7;
  --input: #e4e4e7;
  --ring: var(--primary);

  /* Interactive surface — background for inputs (.dndev-input) and outline
     buttons (.dndev-interactive[data-variant='outline']). Parallel to --card
     for containers. Defaults to transparent (see variables.css). Uncomment
     to tint. */
  /* --interactive: var(--muted); */

  /* Brand colors - customize these */
  --primary: #0284c7;
  --primary-foreground: #ffffff;

  --secondary: #f4f4f5;
  --secondary-foreground: #18181b;

  --accent: #ea580c;
  --accent-foreground: #ffffff;

  /* Status colors */
  --destructive: #dc2626;
  --destructive-foreground: #ffffff;
  --success: #16a34a;
  --success-foreground: #ffffff;
  --warning: #f59e0b;
  --warning-foreground: #09090b;
}

/* ===========================
   DARK THEME
   Zinc-based dark palette
   =========================== */
:root.dark {
  --theme-icon: 'Moon';
  --theme-label: 'Dark';
  --theme-is-dark: 1;

  /* Core colors */
  --background: #09090b;
  --foreground: #fafafa;

  /* Surfaces */
  --card: #09090b;
  --card-foreground: #fafafa;
  --popover: #18181b;
  --popover-foreground: #fafafa;

  /* Muted (zinc-800 / zinc-400) */
  --muted: #27272a;
  --muted-foreground: #a1a1aa;

  /* Border & input (zinc-800) */
  --border: #27272a;
  --input: #27272a;
  --ring: var(--primary);

  /* Brand colors - customize these */
  --primary: #0ea5e9;
  --primary-foreground: #ffffff;

  --secondary: #27272a;
  --secondary-foreground: #fafafa;

  --accent: #f97316;
  --accent-foreground: #ffffff;

  /* Status colors */
  --destructive: #dc2626;
  --destructive-foreground: #ffffff;
  --success: #16a34a;
  --success-foreground: #ffffff;
  --warning: #f59e0b;
  --warning-foreground: #09090b;
}

/* ===========================
   OPTIONAL ESSENCES (do not apply by default; set <html class="brutalist"> or class="luxury" to use)
   See @donotdev/core guidelines/ESSENCES_REFERENCE.css for full .brutalist and .luxury blocks.
   =========================== */

