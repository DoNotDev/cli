/* Next.js app globals.css */
@import '@donotdev/ui/dndev-next.css';

@import './themes.css';

/**
 * Font choices (--font-family, --font-sans, etc.) belong in themes.css.
 * The framework fonts they name are served from public/fonts/ (copied by discovery); own fonts ship none.
 * dndev-next.css = font-stripped variant — use this for Next.js, NOT dndev.css.
 */ 
