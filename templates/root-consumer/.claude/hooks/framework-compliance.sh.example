#!/bin/bash
# .claude/hooks/framework-compliance.sh
# PostToolUse: after Edit/Write, check for framework violations.
# Catches native HTML, Tailwind, CSS imports in source files.

set -euo pipefail

INPUT=$(cat)
FILE_PATH=$(echo "$INPUT" | bun -e "
  const input = JSON.parse(await Bun.stdin.text());
  process.stdout.write(
    input.tool_response?.filePath
    ?? input.tool_input?.file_path
    ?? ''
  );
")

[ -z "$FILE_PATH" ] && exit 0

# Only check component files (tsx/jsx)
case "$FILE_PATH" in
  *.tsx|*.jsx) ;;
  *) exit 0 ;;
esac

# Skip non-component files
case "$FILE_PATH" in
  *Store.ts|*store.ts|*.store.ts) exit 0 ;;
  *Hook.ts|*hook.ts|*.hook.ts) exit 0 ;;
  */utils/*|*/hooks/*|*/stores/*|*/types/*|*/locales/*) exit 0 ;;
esac

VIOLATIONS=""

# Native HTML elements
if grep -nE '<(div|span|p|h[1-6]|button|a|input|textarea|select|table|tr|td|th|ul|ol|li|form|label|img|section|header|footer|nav|main|aside|article)[\s>/]' "$FILE_PATH" 2>/dev/null; then
  VIOLATIONS="${VIOLATIONS}Native HTML elements found. Use framework components (Stack, Card, Text, Button, Link, TextInput, DataTable, etc.).\n"
fi

# Tailwind utility classes
if grep -nE 'className="[^"]*\b(bg-[a-z]|text-[a-z]|p-[0-9]|m-[0-9]|px-|py-|mx-|my-|\bflex\b|\bgrid\b|w-[0-9]|h-[0-9]|gap-|rounded-|border-|shadow-|overflow-)' "$FILE_PATH" 2>/dev/null; then
  VIOLATIONS="${VIOLATIONS}Tailwind utility classes found. Use component props + theme tokens.\n"
fi

# CSS imports
if grep -nE "import.*\.(css|scss|less|module\.css)['\"]" "$FILE_PATH" 2>/dev/null; then
  VIOLATIONS="${VIOLATIONS}CSS import found. No custom CSS - use component props + theme tokens.\n"
fi

if [ -n "$VIOLATIONS" ]; then
  echo -e "FRAMEWORK VIOLATIONS in $FILE_PATH:\n$VIOLATIONS" >&2
  echo "{\"hookSpecificOutput\":{\"hookEventName\":\"PostToolUse\",\"additionalContext\":\"FRAMEWORK VIOLATION in $FILE_PATH. Fix before proceeding: ${VIOLATIONS}\"}}"
  exit 0
fi

exit 0
