#!/bin/bash
# .claude/hooks/guard-files.sh
# PreToolUse hook for Edit and Write operations.
# Blocks edits to protected files. Exit 2 = block, exit 0 = allow.
# Uses bun -e for JSON parsing (bun-first project).

set -euo pipefail

INPUT=$(cat)
FILE_PATH=$(echo "$INPUT" | bun -e "process.stdout.write(JSON.parse(await Bun.stdin.text()).tool_input?.file_path ?? '')")

# No file path = nothing to guard
[ -z "$FILE_PATH" ] && exit 0

BASENAME=$(basename "$FILE_PATH")

# Lock files - never edit directly
case "$BASENAME" in
  bun.lock|bun.lockb|package-lock.json|yarn.lock|pnpm-lock.yaml)
    echo "BLOCKED: Lock files are auto-generated. Do not edit directly." >&2
    exit 2
    ;;
esac

# Environment files - secrets, never edit via agent
case "$BASENAME" in
  .env|.env.local|.env.production|.dndev.secrets)
    echo "BLOCKED: Environment files may contain secrets. Edit manually or use dndev sync-secrets." >&2
    exit 2
    ;;
esac

# Generated files
if echo "$FILE_PATH" | grep -qE '\.(generated|g)\.(ts|js|json)$'; then
  echo "BLOCKED: Generated files should not be edited manually. Regenerate from source." >&2
  exit 2
fi

# AI.md - the SSOT, should not be casually edited by agents
if [ "$BASENAME" = "AI.md" ]; then
  echo "BLOCKED: AI.md is the agent instruction SSOT. Do not modify it." >&2
  exit 2
fi

# --- ALLOW ---
exit 0
