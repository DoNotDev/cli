#!/bin/bash
# .claude/hooks/session-start.sh [subagent]
# SessionStart (startup, /clear, compaction): active phase + project lessons, plain text.
# SubagentStart (arg "subagent"): project lessons as additionalContext JSON, so every
# subagent gets them without a brief carrying them. Explore gets nothing (read-only search);
# Plan starts without CLAUDE.md, so it is told to read AGENTS.md and the rules.
# Lessons: .dndev/LESSONS.md bullets, deprecated and anti-pattern ones left out, score suffix stripped.

set -euo pipefail

cd "$CLAUDE_PROJECT_DIR"

bun -e '
const mode = process.argv[1] ?? "session";
const read = async (p) => ((await Bun.file(p).exists()) ? Bun.file(p).text() : "");

const lessons = (await read(".dndev/LESSONS.md"))
  .split("\n")
  .filter((l) => l.startsWith("- [") && !/status:(deprecated|anti-pattern)/.test(l))
  .map((l) => l.replace(/\s*\{helpful:\d+,harmful:\d+,lastSeen:[^}]+\}$/, ""));
const lessonsBlock = lessons.length
  ? "Project lessons (owner rules learned the hard way; they override your defaults):\n" + lessons.join("\n")
  : "";

if (mode === "subagent") {
  const { agent_type } = JSON.parse(await Bun.stdin.text());
  if (agent_type === "Explore") process.exit(0);
  const parts = [lessonsBlock];
  if (agent_type === "Plan") parts.unshift("Read AGENTS.md and every .claude/rules/*.md file before you plan: they are the project rules.");
  const context = parts.filter(Boolean).join("\n\n");
  if (context) process.stdout.write(JSON.stringify({ hookSpecificOutput: { hookEventName: "SubagentStart", additionalContext: context } }));
  process.exit(0);
}

const protocolText = await read(".dndev/protocol.json");
const protocol = protocolText ? JSON.parse(protocolText) : {};
const phaseLine = Number.isInteger(protocol.currentPhase)
  ? `DoNotDev phase: ${protocol.currentPhase} ${protocol.phaseName}. Call start_phase(${protocol.currentPhase}) before any work; if it fails, stop and report the exact error.`
  : "DoNotDev phase: none started. Call start_phase(0) before any work; if it fails, stop and report the exact error.";
process.stdout.write([phaseLine, lessonsBlock].filter(Boolean).join("\n\n") + "\n");
' "${1:-session}"
