#!/bin/bash
# .claude/hooks/typecheck-stop.sh
# Stop hook: run dndev tc before declaring done.
# Ensures type safety before any work is considered complete.

set -euo pipefail

# Only run if there are uncommitted changes (something was written)
DIRTY=$(git status --porcelain 2>/dev/null | wc -l | tr -d ' ')
[ "$DIRTY" -eq 0 ] && exit 0

echo "Running typecheck before completion..." >&2
if ! dndev tc 2>&1; then
  echo '{"decision":"block","reason":"Typecheck failed. Fix type errors before completing."}'
  exit 0
fi

exit 0
