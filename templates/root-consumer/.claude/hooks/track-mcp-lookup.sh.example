#!/bin/bash
# PostToolUse hook for mcp__donotdev__lookup_symbol
# Appends the looked-up symbol name to a session tracking file.
# Schema: { session_id, tool_name, tool_input: { symbol }, tool_response, ... }
# Cross-platform: bun-first, TMPDIR-safe.

set -euo pipefail

GATE_DIR="${TMPDIR:-/tmp}"
TRACK_FILE="$GATE_DIR/claude-mcp-lookups.txt"

INPUT=$(cat)
SYMBOL=$(echo "$INPUT" | bun -e "
  const d = JSON.parse(await Bun.stdin.text());
  process.stdout.write(d.tool_input?.symbol ?? '');
" 2>/dev/null || echo "")

[ -n "$SYMBOL" ] && echo "$SYMBOL" >> "$TRACK_FILE"

exit 0
