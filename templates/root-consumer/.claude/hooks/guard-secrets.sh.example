#!/bin/bash
# .claude/hooks/guard-secrets.sh
# PreToolUse hook for Edit and Write operations.
# Scans content for accidentally leaked secrets. Exit 2 = block, exit 0 = allow.

set -euo pipefail

INPUT=$(cat)

# Extract content being written (one bun call)
CONTENT=$(echo "$INPUT" | bun -e "
  const d = JSON.parse(await Bun.stdin.text());
  const tn = d.tool_name ?? '';
  let c = '';
  if (tn === 'Edit') c = d.tool_input?.new_string ?? '';
  else if (tn === 'Write') c = d.tool_input?.content ?? '';
  process.stdout.write(c);
")

[ -z "$CONTENT" ] && exit 0

# Skip hook/script files (they contain detection patterns, not actual secrets)
FILE_PATH_EARLY=$(echo "$INPUT" | bun -e "process.stdout.write(JSON.parse(await Bun.stdin.text()).tool_input?.file_path ?? '')")
case "$FILE_PATH_EARLY" in
  *.sh|*.sh.example|*guard-secrets*) exit 0 ;;
esac

VIOLATIONS=""

# AWS Access Key
if echo "$CONTENT" | grep -qE '(AKIA|ASIA)[A-Z0-9]{16}'; then
  VIOLATIONS="${VIOLATIONS}AWS access key detected.\n"
fi

# GitHub token
if echo "$CONTENT" | grep -qE 'gh[pousr]_[A-Za-z0-9_]{36,}'; then
  VIOLATIONS="${VIOLATIONS}GitHub token detected.\n"
fi

# Private key block
if echo "$CONTENT" | grep -q -- '-----BEGIN.*PRIVATE KEY-----'; then
  VIOLATIONS="${VIOLATIONS}Private key detected.\n"
fi

# Generic secret assignment (password/secret/api_key/token = "long_value")
if echo "$CONTENT" | grep -qEi '(password|secret|api[_-]?key|token|credential)\s*[:=]\s*["'"'"'][A-Za-z0-9+/=_-]{20,}'; then
  # Skip if it's a placeholder/example pattern
  if ! echo "$CONTENT" | grep -qEi '(password|secret|api[_-]?key|token|credential)\s*[:=]\s*["'"'"'](your-|example-|replace-|xxx|process\.env)'; then
    VIOLATIONS="${VIOLATIONS}Possible secret assignment detected.\n"
  fi
fi

# JWT (3 dot-separated base64url segments) — skip test/mock files
if echo "$CONTENT" | grep -qE 'eyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}'; then
  FILE_PATH=$(echo "$INPUT" | bun -e "process.stdout.write(JSON.parse(await Bun.stdin.text()).tool_input?.file_path ?? '')")
  case "$FILE_PATH" in
    *test*|*fixture*|*mock*|*.d.ts) ;;
    *) VIOLATIONS="${VIOLATIONS}JWT/service-role key detected.\n" ;;
  esac
fi

if [ -n "$VIOLATIONS" ]; then
  echo -e "BLOCKED: Secret detected in file content:\n${VIOLATIONS}Move secrets to .env and reference via process.env." >&2
  exit 2
fi

exit 0
