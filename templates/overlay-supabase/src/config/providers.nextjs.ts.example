// src/config/providers.ts — Supabase provider bootstrap (client)
// Auto-generated by DoNotDev scaffolding. Edit freely.
// Imported by the app layout (ClientLayout). Server routes generated by the framework
// (sitemap, llms.txt) set up their own read-only reader: never import this file there.

import { configureProviders } from '@donotdev/core';
import {
  createBrowserClient,
  SupabaseAuth,
  SupabaseCallableProvider,
  SupabaseCrudAdapter,
  SupabaseStorageAdapter,
} from '@donotdev/supabase';

// Next.js inlines NEXT_PUBLIC_* only when referenced literally.
const url = process.env.NEXT_PUBLIC_SUPABASE_URL;
const publicKey = process.env.NEXT_PUBLIC_SUPABASE_PUBLIC_KEY; // sb_publishable_...

if (!url || !publicKey) {
  console.warn(
    '[dndev] Supabase not configured. Set NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_PUBLIC_KEY in .env'
  );
} else {
  // Session in cookies: the server renders the signed-in state on the first render.
  const supabase = createBrowserClient(url, publicKey);

  /**
   * Register Supabase as the backend provider.
   * Must run before any CRUD/auth/storage operations.
   */
  configureProviders({
    crud: new SupabaseCrudAdapter(supabase),
    auth: new SupabaseAuth(supabase),
    storage: new SupabaseStorageAdapter(supabase, 'uploads'),
    callable: new SupabaseCallableProvider(supabase),
  });
}
