// functions/src/oauth/exchangeToken.ts

/**
 * @fileoverview {{APP_NAME}} Exchange Token
 * @description Framework OAuth code exchange for the providers {{APP_NAME}} uses
 */

import { createExchangeToken } from '@donotdev/functions/firebase';

/**
 * {{APP_NAME}} OAuth token exchange.
 * List every provider the app connects: each one's `{PROVIDER}_CLIENT_SECRET`
 * is declared (bound at deploy, value in .dndev.secrets) and any other provider
 * is rejected. `{PROVIDER}_CLIENT_ID` goes in functions/.env.
 */
export const exchangeToken = createExchangeToken(['github']);
