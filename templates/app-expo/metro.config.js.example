// Learn more https://docs.expo.dev/guides/customizing-metro
// ESM: the app package.json is "type": "module".
// Expo configures Metro for monorepos itself (SDK 52+): do not set watchFolders or
// node_modules paths here, they replace Expo's and hide the workspace node_modules.
import { getDefaultConfig } from 'expo/metro-config.js';

/** @type {import('expo/metro-config.js').MetroConfig} */
const config = getDefaultConfig(import.meta.dirname);

export default config;
