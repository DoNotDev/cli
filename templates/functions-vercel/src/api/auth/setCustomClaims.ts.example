// functions/src/api/auth/setCustomClaims.ts

/**
 * @fileoverview {{APP_NAME}} Set Custom Claims
 * @description Framework handler letting a signed-in user set their own custom claims
 */

import { createSetCustomClaimsHandler } from '@donotdev/functions/vercel';

/**
 * {{APP_NAME}} custom claims setting
 * Only the claim keys listed here are self-assignable (privilege keys such as
 * `role` or `admin` are always refused). Empty: every key is refused.
 */
export default createSetCustomClaimsHandler({ allowedClaimKeys: [] });
