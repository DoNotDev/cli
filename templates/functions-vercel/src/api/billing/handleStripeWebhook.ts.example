import { createStripeWebhook } from '@donotdev/functions/vercel';

// Import your billing config
// import { billingConfig } from '../../config/billingConfig';
const billingConfig = {}; // TODO: Replace with your StripeBackConfig

// Stripe signs the raw body: disable Next.js body parsing
export const config = { api: { bodyParser: false } };

// backend: 'firebase' | 'supabase' (token verification, claims, idempotency storage)
export default createStripeWebhook(billingConfig, { backend: 'firebase' });
