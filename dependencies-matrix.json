  "notes": {
    "internalDependencies": "Each @donotdev/* package has its own group in the matrix, allowing independent versioning. Each package group contains only that package with its version.",
    "versionPolicy": "Independent versioning - each @donotdev/* package can have its own version (e.g., core 0.0.2, ui 0.0.3, crud 0.0.2)",
    "peerDependencyStrategy": "Runtime libraries (React, Firebase, Stripe) are peer deps to avoid duplication",
    "optionalPeers": "Features are optional peers of composition packages (ui, templates)",
    "optionalPeerDependencyPatterns": {
      "pattern1_groupLevel": "Group-level optional: Set 'optional: true' on group when entire group is always optional everywhere. Use for groups that are universally optional.",
      "pattern2_packageLevel": "Package-level optional: Use peerDependenciesMeta in PackageMapping for package-specific optionality. RECOMMENDED for: shiki, @donotdev/* packages. Example: shiki is optional for components, @donotdev/auth is optional for templates but required for billing.",
      "recommendation": "Use pattern 2 (peerDependenciesMeta) for shiki and @donotdev/* packages since optionality is package-specific, not universal."
    },
    "dependencyClassification": {
      "dependencies": "Packages imported in bundled code that consumers need at runtime. Even if bundled, if import statements remain, consumers must install them. Examples: vite-deps (rollup plugins), postcss, fast-glob",
      "devDependencies": "CLI tools consumers install separately (externalized in bundle). These are NOT bundled - consumers provide them. Examples: vite, next, typescript",
      "peerDependencies": "Optional runtime libraries consumers may already have. Avoids duplication. Examples: react, firebase, stripe",
      "rule": "If imported in code that gets bundled → dependencies. If externalized in esbuild → devDependencies. If optional/consumer-provided → peerDependencies"
    }
  }
